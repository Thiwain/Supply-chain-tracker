<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="sc_tracker_pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.example.entity.Task</class>

        <class>com.thiwain.entity.Country</class>
        <class>com.thiwain.entity.LocationMatrix</class>
        <class>com.thiwain.entity.PackageSender</class>
        <class>com.thiwain.entity.Branch</class>
        <class>com.thiwain.entity.Shipment</class>
        <class>com.thiwain.entity.PackageReceiver</class>
        <class>com.thiwain.entity.Driver</class>
        <class>com.thiwain.entity.ShipmentSts</class>
        <class>com.thiwain.entity.CoastPerKmUsd</class>
        <class>com.thiwain.entity.CoastPerKg</class>
        <class>com.thiwain.entity.Cluster</class>
        <class>com.thiwain.entity.ShipmentHasCluster</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/sc_tracker_db?useSSL=false&amp;serverTimezone=UTC"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="2005@Thiwain"/>

            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>